enum StatusTindakLanjut {
  TERBUKA
  SELESAI
}

/// Kategori bagian SOP pada log aktivitas edit (`LogEditSOP.bagian`).
enum BagianSOP {
  HEADER
  LANGKAH
  STATUS
  UMPAN_BALIK
  EVALUASI
}

/// Jenis diagram SOP (flowchart cetak / BPMN pratinjau).
enum JenisDiagram {
  FLOWCHART
  BPMN
}

enum CabangDiagram {
  UTAMA
  YA
  TIDAK
}

enum SisiPanahDiagram {
  top
  bottom
  left
  right
}

/// Agregat konfigurasi diagram per DetailSOP (bukan junction M:N). Layout node otomatis di klien.
model KonfigurasiDiagramSOP {
  detailSopId   String                    @db.Char(36)
  jenis         JenisDiagram
  layoutSeed    Int                       @default(0)
  updatedAt     DateTime                  @updatedAt
  overridePanah OverridePanahDiagramSOP[]
  overrideLabel OverrideLabelDiagramSOP[]

  detailSop DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, jenis])
  @@index([detailSopId])
}

/// Override koordinat panah manual (anak `KonfigurasiDiagramSOP`).
model OverridePanahDiagramSOP {
  detailSopId      String           @db.Char(36)
  jenis            JenisDiagram
  dariLangkahSopId String           @db.Char(36)
  keLangkahSopId   String           @db.Char(36)
  cabang           CabangDiagram
  sSide            SisiPanahDiagram
  eSide            SisiPanahDiagram
  startX           Float
  startY           Float
  endX             Float
  endY             Float
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  konfigurasiDiagram KonfigurasiDiagramSOP       @relation(fields: [detailSopId, jenis], references: [detailSopId, jenis], onDelete: Cascade)
  dariLangkah        LangkahSOP                  @relation("OverridePanahDariLangkah", fields: [dariLangkahSopId], references: [langkahSopId], onDelete: Cascade)
  keLangkah          LangkahSOP                  @relation("OverridePanahKeLangkah", fields: [keLangkahSopId], references: [langkahSopId], onDelete: Cascade)
  titikTekuk         TitikTekukPanahDiagramSOP[]

  @@id([detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang])
  @@index([dariLangkahSopId])
  @@index([keLangkahSopId])
}

/// Titik tekuk panah berurutan (anak `OverridePanahDiagramSOP`).
model TitikTekukPanahDiagramSOP {
  detailSopId      String        @db.Char(36)
  jenis            JenisDiagram
  dariLangkahSopId String        @db.Char(36)
  keLangkahSopId   String        @db.Char(36)
  cabang           CabangDiagram
  urutan           Int
  x                Float
  y                Float

  overridePanah OverridePanahDiagramSOP @relation(fields: [detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang], references: [detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang], onDelete: Cascade)

  @@id([detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang, urutan])
}

/// Posisi label diagram manual (anak `KonfigurasiDiagramSOP`).
model OverrideLabelDiagramSOP {
  detailSopId String       @db.Char(36)
  jenis       JenisDiagram
  kunciLabel  String       @db.VarChar(8)
  posisiX     Float
  posisiY     Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  konfigurasiDiagram KonfigurasiDiagramSOP @relation(fields: [detailSopId, jenis], references: [detailSopId, jenis], onDelete: Cascade)

  @@id([detailSopId, jenis, kunciLabel])
}
