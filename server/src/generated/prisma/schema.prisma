  DRAFT
  SEDANG_DISUSUN
  MENUNGGU_PENGAJUAN_EVALUASI
  DIAJUKAN_EVALUASI
  SEDANG_DIEVALUASI
  REVISI_DARI_EVALUATOR
  DITOLAK_EVALUATOR
  MENUNGGU_TTD_PJ_EVALUATOR
  DIVERIFIKASI_PJ_EVALUATOR_ORGANISASI
  BERLAKU
  DIGANTIKAN
  DICABUT
}

enum JenisLangkahProsedur {
  AWAL_AKHIR
  KEGIATAN
  KEPUTUSAN
}

enum SatuanWaktu {
