{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "prestart:dev": "prisma migrate deploy && prisma generate",
    "start:dev": "nest start --watch",
    "prestart:debug": "prisma migrate deploy && prisma generate",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:core-unit": "jest auth.service.spec.ts auth.shared.spec.ts auth.controller.spec.ts auth.repository.spec.ts jwt-access.strategy.spec.ts auth.dto.spec.ts roles.guard.spec.ts penyusun.service.spec.ts kepala-opd.service.spec.ts kepala-opd.controller.spec.ts kepala-opd.repository.spec.ts kepala-opd.dto.spec.ts evaluator.service.spec.ts pelaksana.service.spec.ts pelaksana.controller.spec.ts pelaksana.repository.spec.ts pelaksana.dto.spec.ts peraturan.service.spec.ts sop-catalog.service.spec.ts sop-prosedur.service.spec.ts sop-diagram.service.spec.ts sop-completeness.validator.spec.ts sop-status-policy.spec.ts pengajuan-evaluasi.service.spec.ts evaluasi-nilai.service.spec.ts evaluasi-nilai.controller.spec.ts evaluasi-nilai.repository.spec.ts evaluasi-nilai.dto.spec.ts evaluasi-revisi.policy.spec.ts nilai-opd-skor.constants.spec.ts nilai-evaluasi-client-id.spec.ts evaluasi-umpan-balik.service.spec.ts tte.service.spec.ts tte-profil.service.spec.ts tte.controller.spec.ts tte-profil.dto.spec.ts tte.repository.spec.ts sop-public.service.spec.ts evaluasi-grafik.service.spec.ts indonesian-mobile-number.util.spec.ts notification-module-boundaries.spec.ts in-app-notification.service.spec.ts notification-recipient-resolver.service.spec.ts notification-reminder-reconciler.service.spec.ts notification-reminder-scheduler.service.spec.ts env.validation.spec.ts --runInBand",
    "test:evaluasi-sop-unit": "jest sop-catalog.service.spec.ts pengajuan-evaluasi.service.spec.ts evaluasi-nilai.service.spec.ts evaluasi-nilai.controller.spec.ts evaluasi-nilai.repository.spec.ts evaluasi-nilai.dto.spec.ts evaluasi-revisi.policy.spec.ts nilai-opd-skor.constants.spec.ts nilai-evaluasi-client-id.spec.ts tte.service.spec.ts sop-public.service.spec.ts --runInBand",
    "test:integration": "node -e \"console.error('Integration test wajib Docker. Jalankan: pnpm test:integration:docker'); process.exit(1)\"",
    "test:integration:run": "jest --config ./test/jest-integration.json --runInBand",
    "test:integration:docker": "docker compose -f ../docker-compose.test.yml --profile test run --rm sop-integration-test",
    "test:integration:docker:pdf": "docker compose -f ../docker-compose.test.yml --profile test run --rm -e INTEGRATION_TEST_PATTERN=tte-pdf-qr-verifikasi sop-integration-test",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "pdf-signing:generate-cert": "node scripts/generate-pdf-signing-cert.cjs",
    "db:seed": "prisma migrate deploy && prisma db seed",
    "db:seed:e2e": "ts-node --transpile-only prisma/seed-e2e.ts",
    "db:fresh": "prisma migrate reset --force"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/adapter-mariadb": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@prisma/client-runtime-utils": "^7.6.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ms": "^2.1.3",
    "nest-winston": "^1.10.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/generated/**",
      "!src/generated/**",
      "!**/*.module.ts",
      "!app.module.ts",
      "!main.ts",
      "!**/*.controller.ts",
      "!**/*.repository.ts",
      "!**/*.dto.ts",
      "!**/dto/**",
      "!database/seed/seed.service.ts",
      "!config/env.validation.ts",
      "!modules/tte/penandatanganan/tte-pdf-signing.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node",
    "verbose": true,
    "testTimeout": 30000
  }
}
