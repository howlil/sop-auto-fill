# Public routing
FRONTEND_PORT=8080
PUBLIC_APP_ORIGIN=https://sop.example.com

# Google Identity Services
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# Application auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=7d

# MySQL
MYSQL_DATABASE=sopflow
MYSQL_USER=sopflow
MYSQL_PASSWORD=replace-with-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# AI-assisted drafting (disabled by default)
AI_DRAFT_PROVIDER=disabled
AI_DRAFT_TIMEOUT_MS=30000

# AI SOP quality review (disabled by default)
AI_REVIEW_PROVIDER=disabled
AI_REVIEW_TIMEOUT_MS=30000

# Set these when either AI_DRAFT_PROVIDER=openai or AI_REVIEW_PROVIDER=openai
# OPENAI_API_KEY=replace-with-server-side-openai-api-key
# OPENAI_MODEL=replace-with-supported-model-id

# Optional production behavior
SWAGGER_ENABLED=false
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
